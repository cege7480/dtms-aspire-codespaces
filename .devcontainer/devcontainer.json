{
    "name": "DTMS.Aspire Development",
    "image": "mcr.microsoft.com/devcontainers/dotnet:8.0",
    
    "hostRequirements": {
        "cpus": 8,
        "memory": "16gb",
        "storage": "32gb"
    },
    
    "features": {
       	"ghcr.io/devcontainers/features/azure-cli:1": {},
		"ghcr.io/devcontainers/features/git-lfs:1": {},
		"ghcr.io/devcontainers/features/node:1": {},
		"ghcr.io/devcontainers/features/powershell:1": {},
		"ghcr.io/eitsupi/devcontainer-features/jq-likes:2": {},		
		"ghcr.io/stuartleeks/dev-container-features/azure-cli-persistence:0": {},
		"ghcr.io/jsburckhardt/devcontainer-features/uv:1": {},		
		"ghcr.io/azure/azure-dev/azd:0": {},
		"ghcr.io/nikiforovall/devcontainer-features/dotnet-csharpier:1": {},
		"ghcr.io/devcontainers-extra/features/mkcert:1": {},
		"ghcr.io/devcontainers-extra/features/vscode-cli:1": {},
		"ghcr.io/dotnet/aspire-devcontainer-feature/dotnetaspire:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/sshd:1": {},
		"ghcr.io/joshuanianji/devcontainer-features/github-cli-persistence:1": {},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },
    
    "customizations": {
        "vscode": {
            "extensions": [
               "DanielLaskewitz.power-platform-connectors",
				"TeamsDevApp.vscode-adaptive-cards",
				"ms-azuretools.vscode-apimanagement",
				"irarainey.applicationregistrations",
				"ms-azuretools.vscode-azurecontainerapps",
				"ms-azuretools.vscode-cosmosdb",
				"ms-azure-devops.azure-pipelines",
				"BenHesketh21.azure-pipelines-renderer",
				"ms-azuretools.vscode-azurestorage",
				"MelodicDevelopment.azure-work-management",
				"danish-naglekar.dataverse-devtools",
				"github.copilot-workspace",
				"aliasadidev.nugetpackagemanagergui",
				"danish-naglekar.pcf-builder",
				"ms-dotnettools.dotnet-interactive-vscode",
				"microsoft-IsvExpTools.powerplatform-vscode",
				"TeamsDevApp.ms-teams-vscode-extension",
				"rangav.vscode-thunder-client",
				"ms-vscode.copilot-mermaid-diagram",
				"redhat.vscode-yaml",
				"RooVeterinaryInc.roo-cline",
				"ms-vscode-remote.remote-containers",
				"ni.azdo-wiki-md",
				"bierner.markdown-mermaid"
            ]
        }
    },
    
    "forwardPorts": [5000, 5001],
    "postCreateCommand": ""
}
